APP_ENV=production
SECURE_SSL_REDIRECT=true
APP_URL=https://services.example.invalid
AUTH_SECRET=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=services.example.invalid,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://services.example.invalid
DATABASE_URL=
POSTGRES_DB=service_portal
POSTGRES_USER=service_portal
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_SSLMODE=prefer
FILE_STORAGE_TYPE=local
UPLOAD_PATH=/app/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_SIZE=10485760
REPORT_AT_RISK_RATIO=0.8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,png,jpg,jpeg,zip
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-strong-temporary-password
INITIAL_ADMIN_EMAIL=admin@example.internal
INITIAL_ADMIN_FULL_NAME=مدیر سامانه
