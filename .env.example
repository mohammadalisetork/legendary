# Local UAT only. These placeholders are not production credentials.
APP_ENV=development
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
APP_URL=http://localhost:8000
AUTH_SECRET=local-uat-only-placeholder-not-for-production-00000000000000000000
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Docker Compose PostgreSQL defaults. Compose sets POSTGRES_HOST=db for the app.
# Leave DATABASE_URL empty so the POSTGRES_* settings are used in Docker.
DATABASE_URL=
POSTGRES_DB=service_portal
POSTGRES_USER=service_portal
POSTGRES_PASSWORD=local-uat-only-not-for-production
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_SSLMODE=prefer

# Local persistent uploads use the Compose uploads volume.
FILE_STORAGE_TYPE=local
UPLOAD_PATH=/app/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_SIZE=10485760

# Application behavior defaults for local review.
REPORT_AT_RISK_RATIO=0.8
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,png,jpg,jpeg,zip

# Demo seed creates the local review accounts; don't create a separate admin.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
